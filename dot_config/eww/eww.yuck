;;; Watchers
(deflisten workspaces :initial  "[]"   "bash ~/.config/eww/scripts/getinfo all-workspaces")
(deflisten current_ws :initial  "1"    "bash ~/.config/eww/scripts/getinfo active-workspace")
(deflisten window     :initial  "..."  "sh ~/.config/eww/scripts/get-window-title")
(deflisten song_name      :initial  ""     "playerctl --follow metadata --format '{{ title }}' || true")
(deflisten song_artist      :initial  ""     "playerctl --follow metadata --format '{{ artist }}' || true")
(deflisten song_time      :initial  ""     "playerctl --follow metadata --format '{{ position }}' || true")
(deflisten song_status      :initial  ""     "playerctl status || true")
(deflisten batt_id    :initial  "BAT0" "ls /sys/class/power_supply | grep BAT")
(defpoll   volume     :interval "1s"   "sh ~/.config/eww/scripts/getvol")
(defpoll   time_hr     :interval "10s"   "date '+%H'")
(defpoll   time_min     :interval "10s"   "date '+%M'")
(defpoll   time_sec     :interval "1s"    "date '+%S'")
(defpoll   time_yr       :interval "1s"   "date '+%Y'")
(defpoll   time_mo       :interval "1s"   "date '+%m'")
(defpoll   time_mo_s       :interval "1s"   "date '+%b'")
(defpoll   time_mo_s2       :interval "1s"   "date '+%B'")
(defpoll   time_day       :interval "1s"   "date '+%d'")
(defpoll   time_day_s       :interval "1s"   "date '+%A'")
(defpoll   network    :interval "2s"   "sh ~/.config/eww/scripts/get-network")

;;; bar/
(include "./bar/bar.yuck")
(defvar center_selected 0)
(defvar center_dir "slidedown")
(defvar launch-val "")
(defvar search-res-name "")
(defvar search-res-path "")

;;; panel/
(include "./panel/panel.yuck")