(include "./bar/metrics.yuck")

(defwindow bar
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "100%"
    :height "1%"
    :anchor "top center"
  )
  :exclusive true
  :namespace "dnrk-eww"
  :focusable "onDemand"
  (bar)
)

(defwidget bar []
  (centerbox :orientation "h"
    (workspaces)
    (center)
    (tray)
  ))

;;; left side of bar

(defwidget workspaces []
  (box :space-evenly true :halign "start" :spacing 10 :class "workspaces"
    (label :text "${current_ws}" :visible false)
    (for workspace in workspaces
      (eventbox :onclick "hyprctl dispatch workspace ${workspace.id}"
        (box :class "workspace-entry"
          (label :text "${workspace.id == current_ws ? " " : workspace.windows > 0 ? " " : " " }")
        )))))

;;; right side of bar

(defwidget tray []
  (box
    :space-evenly false
    :halign "end"
    :class "tray"
    :spacing 15
    
    (systray :icon-size 20 :spacing 15)
    
    (vol) ;;; from metrics
    (net) ;;; from metrics
    (bat) ;;; from metrics
    (label :text "${time_mo_short} ${time_day}, ${time_yr}")
  ))

;;; center of bar (multi-widget)

(defwidget center []
  (eventbox :class "center"
    :orientation "h"
    :space-evenly true
    :halign "center"
    (stack
      :selected center_selected
      :transition center_dir
      :same-size true
      
      (clock_hud)
      (powermenu)
      (search_bar)
    )))

;;; center bar options

(defwidget powermenu [] (box
    :class "power-menu"
    :orientation "h"
    :space-evenly true

    ;;; shutdown
    (button
      :onclick "hyprctl dispatch powermenu"
      (label :text "" :class "power-menu-icon")
    )
    
    ;;; reboot
    (button
      :onclick "hyprctl dispatch reboot"
      (label :text "" :class "power-menu-icon")
    )
    
    ;;; hibernate
    (button
      :onclick "hyprctl dispatch hibernate && eww update center_selected=0"
      (label :text "" :class "power-menu-icon")
    )
    
    ;;; suspend
    (button
      :onclick "hyprctl dispatch suspend && eww update center_selected=0"
      (label :text "" :class "power-menu-icon")
    )
    
    ;;; logout
    (button
      :onclick "hyprctl dispatch exit && eww update center_selected=0"
      (label :text "" :class "power-menu-icon")
    )
    
    ;;; lock
    (button
      :onclick "hyprctl dispatch exec hyprlock && eww update center_selected=0"
      (label :text "" :class "power-menu-icon")
    )
  ))

(defwidget search_bar [] (box
    :class "searchbox"
    :orientation "h"
    (input
      :value launch-val
      :active true
      :onchange "bash ~/.config/eww/scripts/launchbar {}"
      :onaccept "bash ~/.config/eww/scripts/launchbar launch"
    )
    (label :text search-res-name)
    (label :text search-res-path :visible false)
  ))

(defwidget clock_hud []
  (box
    :hexpand false
    (label
      :text "${time_hr}:${time_min}:${time_sec}"
    )
  )
)