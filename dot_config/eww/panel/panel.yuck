(defwindow panel
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "20%"
    :height "90%"
    :anchor "center left"
  )
  :exclusive false
  :namespace "dnrk-eww"
  :focusable "onDemand"
  (panel)
)

(defwidget panel [] (box
    :orientation "v"
    :space-evenly false
    (time)
    (box
      (music)
      (music_ctl)
      ; (music_prog)
    )
  ))


(defwidget time []
  (box
    :orientation "v"
    :space-evenly false
    :class "panel-datetime"
    (centerbox
      :orientation "h"
      :hexpand true
      (label :class "sz-large wgt-heavy"   :text time_hr)
      (label :class "sz-large wgt-med" :text time_min)
      (label :class "sz-large wgt-light" :text time_sec)
    )
    (centerbox
      :orientation "h"
      :hexpand true
      (label :class "sz-med wgt-light"  :text time_yr)
      (label :class "sz-med wgt-med" :text time_mo)
      (label :class "sz-med wgt-heavy"   :text time_day)
    )
    (centerbox
      :orientation "h"
      :hexpand true
      (label :text "")
      (label :class "sz-small wgt-light" :text time_mo_long)
      (label :class "sz-small wgt-light" :text time_day_week)
    )
  ))

(defwidget music []
  (box
    :orientation "v"
    :space-evenly "false"
    :vexpand "false"
    :hexpand "false"
    (label :halign "start" :class "sz-large wgt-heavy" :wrap "false" :text song_name)
    (label :halign "start" :class "sz-med   wgt-med"   :wrap "true"  :text song_artist)
  ))

(defwidget music_ctl []
  (box
    :orientation "v"
    :spacing 1
    :halign "center"
    :space-evenly false
    :vexpand false
    :hexpand false
    (button :class "song_btn" :onclick "playerctl previous" "")
    (button :class "song_btn" :onclick "playerctl play-pause" song_status)
    (button :class "song_btn" :onclick "playerctl next" "")
    (button :class "song_btn" :onclick "playerctl shuffle toggle" song_shuffle)
    (button :class "song_btn" :onclick "" song_loop)
  ))


(defwidget music_prog []
  (box :orientation "v" :spacing 5 :space-evenly "false" :vexpand "false" :hexpand "false" :class "music_prog_bg"
    (scale :value song_time :halign "start" :class "song_prog" :min 0 :max song_length :step 1)
  ))