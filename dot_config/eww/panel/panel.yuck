(defwindow panel
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "20%"
    :height "90%"
    :anchor "center left"
  )
  :exclusive false
  :namespace "dnrk-eww"
  :focusable "onDemand"
  (panel)
)

(defwidget panel [] (box
    :orientation "v"
    :space-evenly false
    (time)
    (music)
  ))


(defwidget time []
  (box
    :orientation "v"
    :space-evenly false
    :class "panel-datetime"
    (centerbox
      :orientation "h"
      :hexpand true
      (label :class "sz-large wgt-heavy" :text time_hr)
      (label :class "sz-large wgt-med"   :text time_min)
      (label :class "sz-large wgt-light" :text time_sec)
    )
    (centerbox
      :orientation "h"
      :hexpand true
      (label :class "sz-med wgt-light" :text time_yr)
      (label :class "sz-med wgt-med"   :text time_mo)
      (label :class "sz-med wgt-heavy" :text time_day)
    )
    (centerbox
      :orientation "h"
      :hexpand true
      (label :text "")
      (label :class "sz-small wgt-light" :text time_mo_long)
      (label :class "sz-small wgt-light" :text time_day_week)
    )
  ))

(defwidget music []
  (box
    :orientation "v"
    :class "panel-music"
    :space-evenly true
    (label :halign "start" :class "sz-small wgt-light" :limit-width 40 :text song_album)
    (label :halign "start" :class "sz-large wgt-heavy" :limit-width 40 :text song_name)
    (label :halign "start" :class "sz-med   wgt-med"   :limit-width 40 :text song_artist)
    (music_ctl)
    (box :class "metric"
      (scale
        :value song_time
        :class "song_prog"
        :hexpand true
        :max song_length
        :step 1
        :onchange "playerctl position $(({} / 1000000))"
      ))
  ))

(defwidget music_ctl []
  (box
    :orientation "h"
    :halign "center"
    :space-evenly true
    :hexpand true
    (button :class "song_btn" :onclick "playerctl previous" "")
    (button :class "song_btn" :onclick "playerctl play-pause" song_status)
    (button :class "song_btn" :onclick "playerctl next" "")
    (button :class "song_btn" :onclick "playerctl shuffle toggle" song_shuffle)
    (button :class "song_btn" :onclick "bash ~/.config/eww/scripts/toggle media-loop" song_loop)
  ))