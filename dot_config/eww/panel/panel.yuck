(defwindow panel
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "20%"
    :height "90%"
    :anchor "center left"
  )
  :exclusive false
  :namespace "dnrk-eww"
  :focusable "onDemand"
  (panel)
)

(defwidget panel [] (box
    :orientation "v"
    :space-evenly false
    (time)
    (music)
    (sys_vitals)
  ))


(defwidget time []
  (box
    :orientation "v"
    :space-evenly false
    :class "panel-datetime"
    (centerbox
      :orientation "h"
      :hexpand true
      (label :class "sz-large wgt-heavy" :text time_hr)
      (label :class "sz-large wgt-med"   :text time_min)
      (label :class "sz-large wgt-light" :text time_sec)
    )
    (centerbox
      :orientation "h"
      :hexpand true
      (label :class "sz-med wgt-light" :text time_yr)
      (label :class "sz-med wgt-med"   :text time_mo)
      (label :class "sz-med wgt-heavy" :text time_day)
    )
    (centerbox
      :orientation "h"
      :hexpand true
      (label :class "sz-small wgt-light" :text "${time_hr_12} ${time_meridian}")
      (label :class "sz-small wgt-light" :text time_mo_long)
      (label :class "sz-small wgt-light" :text time_day_week)
    )
  ))

(defwidget music []
  (box
    :orientation "v"
    :class "panel-music"
    :space-evenly false
    (box
      :space-evenly false
      
      (image
        :path song_cover
        :image-width 125
        :class "song_cover"
      )
      
      (box :orientation "v"
        :space-evenly false
        (label :halign "start" :class "sz-small   wgt-light" :limit-width 40 :text song_album :style "margin-top: 30px;")
        (label :halign "start" :class "sz-med     wgt-heavy" :limit-width 40 :text song_name)
        (label :halign "start" :class "sz-smaller wgt-med"   :limit-width 40 :text song_artist)
      )
    )
    (music_ctl)
    (box :class "metric"
      (scale
        :value song_time
        :class "song_prog"
        :hexpand true
        :max song_length
        :step 1
        :onchange "playerctl position $(({} / 1000000))"
      ))
  ))

(defwidget music_ctl []
  (box
    :orientation "h"
    :halign "center"
    :space-evenly true
    :hexpand true
    (button :class "song_btn" :onclick "playerctl previous" "")
    (button :class "song_btn" :onclick "playerctl play-pause" song_status)
    (button :class "song_btn" :onclick "playerctl next" "")
    (button :class "song_btn" :onclick "playerctl shuffle toggle" song_shuffle)
    (button :class "song_btn" :onclick "bash ~/.config/eww/scripts/toggle media-loop" song_loop)
  ))

(defwidget sys_vitals [] (box
    :class "panel-vitals"
    :orientation "h"
    :space-evenly true
    :vexpand false
    (box
      :class "vital-container"
      :orientation "v"
      :tooltip "CPU: ${(EWW_CPU.avg / arraylength(EWW_CPU.cores)) * 100}%"
      :space-evenly false
      (circular-progress
        :value "${(EWW_CPU.avg / arraylength(EWW_CPU.cores)) * 100}"
        :class "vital"
        :thickness 50
      )
      (box :class "sz-med wgt-med" "cpu"))
    (box
      :class "vital-container"
      :orientation "v"
      :tooltip "MEM: ${EWW_RAM.used_mem_perc}%"
      :space-evenly false
      (circular-progress
        :value "${EWW_RAM.used_mem_perc}"
        :class "vital"
        :thickness 50
      )
      (box :class "sz-med wgt-med" "mem"))
    (box
      :class "vital-container"
      :orientation "v"
      :tooltip "DISK: ${EWW_DISK["/"].used_perc}%"
      :space-evenly false
      (circular-progress
        :value "${EWW_DISK["/"].used_perc}"
        :class "vital"
        :thickness 50
      )
      (box :class "sz-med wgt-med" "disk"))
    (box
      :class "vital-container"
      :orientation "v"
      :tooltip "${network.connected ? "${network.address} - ${network.name} (${network.strength}%)" : "No Network"}"
      :space-evenly false
      (circular-progress
        :value "${network.strength}"
        :class "vital"
        :thickness 50
      )
      (box :class "sz-med wgt-med" "net"))
  ))