#
# Please note not all available settings / options are set here.
# For a full list, see the wiki (https://wiki.hyprland.org/Configuring/)
#

$mainMod = SUPER
$terminal = {{ if hasKey . "terminal" }}{{ .terminal | quote }}{{ else }}"kitty"{{ end }} 
$browser = {{ if hasKey . "browser" }}{{ .browser | quote }}{{ else }}"zen-browser"{{ end }}

$active1 = {{  if hasKey . "active1" }}{{ .active1 }}{{ else }} rgba(00abffff) {{ end }}
$active2 = {{  if hasKey . "active2" }}{{ .active2 }}{{ else }} rgba(dc38ffff) {{ end }}
$active3 = {{  if hasKey . "active3" }}{{ .active3 }}{{ else }} rgba(ff3434ff) {{ end }}

$inactive1 = {{  if hasKey . "inactive1" }}{{ .inactive1 }}{{ else }} rgba(777777aa) {{ end }}
$inactive2 = {{  if hasKey . "inactive2" }}{{ .inactive2 }}{{ else }} rgba(000000aa) {{ end }}

###############################3
# configuration
#

monitor=,preferred,auto,1
env = XCURSOR_SIZE,24
env = GTK_THEME,Adwaita:dark

# startup
# exec-once = eww daemon && eww open bar # widgets
exec-once = caelestia shell -d
exec-once = swww-daemon --format xrgb # wallpaper
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 # authentication agent

# input config
input {
    kb_layout = us
    follow_mouse = 1 # focus follows mouse
    touchpad {
        # natural scrolling on touchpad
        natural_scroll = yes
    }
}
cursor {
    # Fixes nvidia issues
    no_hardware_cursors = true
}

# window styling
general {
    gaps_in = 5 # between windows
    gaps_out = 10 # around edge
    border_size = 2
    col.active_border = $active1 $active2 $active3 30deg
    col.inactive_border = $inactive1 $inactive2 $inactive1 30deg
    layout = dwindle # dynamic placement (other is `master`)
}
decoration {
    rounding = 5
    inactive_opacity = 0.75
    blur {
        enabled = true
        size = 8
        passes = 2
    }
}
animations {
    enabled = yes
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05

    animation = windows, 1, 7, myBezier
    animation = windowsOut, 1, 7, default, popin 80%
    animation = border, 1, 10, default
    animation = borderangle, 1, 8, default
    animation = fade, 1, 7, default
    animation = workspaces, 1, 6, default
}

misc {
    # disables built-in wallpaper, we have our own
    disable_hyprland_logo = true
}

###############################3
# specific rules
#

windowrulev2 = nofocus,class:^ghidra-.+$,title:^win.+$,floating:1,fullscreen:0 # float ghidra
windowrule = opacity 0.90, class:feishin

# rules for eww widgets
layerrule = blur, dnrk-eww
layerrule = blurpopups, dnrk-eww
layerrule = xray on, dnrk-eww
layerrule = ignorezero, dnrk-eww

###############################3
# controls
#

### action controls
# adjust window
bind = $mainMod SHIFT, Q, killactive,
bind = $mainMod, V, togglefloating, 
# change focus
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d
# scroll active workspaces
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1
# resize window
bindm = $mainMod, mouse:272, movewindow # left mouse
bindm = $mainMod, mouse:273, resizewindow # right mouse
bindm = $mainMod ALT, mouse:272, resizewindow
# color picker
bind = $mainMod, P, exec, hyprpicker -a
# screenshot
bind = $mainMod, S, exec, hyprshot -m region --clipboard-only
bind = $mainMod CONTROL, S, exec, hyprshot
bind = $mainMod SHIFT, S, exec, hyprshot -m output --clipboard-only
bind = $mainMod CONRTROL_SHIFT, S, exec, hyprshot -m output # this doesn't seem to work

### app shortcuts
# terminal
bind = $mainMod, RETURN, exec, $terminal
# browser
bind = ,XF86AudioMedia, exec, $browser
# runner (wofi)
# bind = $mainMod, SPACE, exec, wofi --show drun --insensitive --style ~/.config/wofi/style.css --prompt ""
# runner (caelestia)
bind = $mainMod, SPACE, global, caelestia:launcher

### eww shortcuts
# runner (incomplete :( )
# bind = $mainMod SHIFT, SPACE, exec, bash ~/.config/eww/scripts/toggle bar 2
# power menu
# bind = $mainMod, M, exec, bash ~/.config/eww/scripts/toggle bar 1
# side panel
# bind = $mainMod, ESCAPE, exec, eww open --toggle panel

### caelestia shortcuts
bind = $mainMod, M, global, caelestia:session
bind = $mainMod, L, global, caelestia:lock


### workspaces
# change
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10
# move window
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

### functional keys
# audio
bind   = ,XF86AudioMute,        exec, pactl set-sink-mute @DEFAULT_SINK@ toggle
bindel = ,XF86AudioRaiseVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ +1%
bindel = ,XF86AudioLowerVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ -1%
bindl  = ,XF86AudioPrev,        exec, playerctl previous
bindl  = ,XF86AudioPlay,        exec, playerctl play-pause
bindl  = ,XF86AudioNext,        exec, playerctl next
# brightness
bindel = ,XF86MonBrightnessUp,   exec, brightnessctl s +1%
bindel = ,XF86MonBrightnessDown, exec, brightnessctl s 1%-

### misc.
# lock screen on lid close
# bindl=,switch:Lid Switch,exec,hyprlock
bindl=,switch:Lid Switch,global,caelestia:lock
